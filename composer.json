{
    "name": "jeffersongoncalves/filament-action-export",
    "description": "Export Filament tables to CSV, XLSX and PDF with preview and print support.",
    "type": "library",
    "license": "MIT",
    "keywords": ["filament", "export", "csv", "xlsx", "pdf", "laravel", "livewire"],
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^2.0|^3.0",
        "filament/filament": "^4.0",
        "spatie/laravel-package-tools": "^1.13",
        "spatie/simple-excel": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "suggest": {
        "barryvdh/laravel-snappy": "Required for Snappy PDF driver support."
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\FilamentExportAction\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\FilamentExportAction\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\FilamentExportAction\\FilamentExportServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
